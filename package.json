{
  "name": "better-auth-drizzle-adapter",
  "version": "1.0.0",
  "description": "Drizzle ORM v1 adapter for Better Auth with relations v2 support. Vendored from better-auth/better-auth#9489.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/better-auth-drizzle-adapter.git"
  },
  "keywords": [
    "better-auth",
    "drizzle",
    "drizzle-orm",
    "adapter",
    "relations-v2",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && node -e \"const fs=require('fs');const f=fs.readdirSync('dist').find(x=>x.endsWith('.d.ts')&&x!=='index.d.ts');if(f)fs.renameSync('dist/'+f,'dist/index.d.ts')\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0",
    "drizzle-orm": ">=1.0.0-beta.1"
  },
  "devDependencies": {
    "@better-auth/core": "1.6.14",
    "drizzle-orm": "1.0.0-beta.21",
    "tsdown": "^0.12.5",
    "typescript": "^5.9.3"
  }
}
