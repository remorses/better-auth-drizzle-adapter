{
  "name": "better-auth-drizzle-adapter",
  "version": "1.0.1",
  "description": "Drizzle ORM v1 adapter for Better Auth with relations v2 support. Vendored from better-auth/better-auth#9489.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/better-auth-drizzle-adapter.git"
  },
  "homepage": "https://github.com/remorses/better-auth-drizzle-adapter",
  "bugs": "https://github.com/remorses/better-auth-drizzle-adapter/issues",
  "keywords": [
    "better-auth",
    "drizzle",
    "drizzle-orm",
    "adapter",
    "relations-v2",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0",
    "drizzle-orm": ">=1.0.0-beta.1"
  },
  "devDependencies": {
    "@better-auth/core": "1.6.14",
    "@types/node": "^25.9.1",
    "drizzle-orm": "1.0.0-beta.21",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
